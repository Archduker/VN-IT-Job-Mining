ầy đủ chế độ bảo hiểm: BHXH, BHYT, BHTN\u003cbr\u003e- Quà cho nhân viên vào các dịp Lễ, Tết.\u003cbr\u003e- Nghỉ phép năm.\u003cbr\u003e- Các hoạt động team building hàng năm\u003cbr\u003e- Trang bị đầy đủ trang thiết bị làm việc (máy tính/ điện thoại)\u003cbr\u003e- Đào tạo nghiệp vụ và kỹ năng trước khi bắt đầu công việc\u003c/p\u003e","qualifications":"Trung học","industry":"IT Phần cứng - Mạng,Chăm sóc khách hàng,Bán hàng - Kinh doanh,Bán hàng - Kinh doanh,IT Phần cứng - Mạng","identifier":{"@type":"PropertyValue","name":"Công Ty TNHH Transcosmos Việt Nam","value":"5816028"},"experienceRequirements":{"@type":"OccupationalExperienceRequirements","monthsOfExperience":12},"datePosted":"2026-10-16","validThrough":"2026-10-31T23:59:59+07:00","employmentType":"FULL_TIME","hiringOrganization":{"@type":"Organization","name":"Công Ty TNHH Transcosmos Việt Nam","sameAs":"https://vieclam24h.vn/danh-sach-tin-tuyen-dung-cong-ty-tnhh-transcosmos-viet-nam-ntd5816028p122.html","logo":"https://cdn1.vieclam24h.vn/images/employer_avatar/2024/06/21/dd68a8ecd70674582d17_171895568869.h-300.w-300.fit-crop.jpg"},"jobLocation":[{"@type":"Place","address":{"@type":"PostalAddress","streetAddress":"Tòa nhà Scetpa, 19A Cộng Hòa","addressLocality":"Bảy Hiền","addressRegion":"TP.HCM","postalCode":"700000 - 710000 - 720000 - 730000 - 740000 - 750000 - 780000","addressCountry":"VN"}}],"baseSalary":{"@type":"MonetaryAmount","currency":"VND","value":{"@type":"QuantitativeValue","unitText":"MONTH","minValue":8500000,"maxValue":20000000}}},"statusCode":200,"args":{"id":"200966957"}},"seoMeta":{"code":200,"msg":"Successfully","data":{"id":1,"priority":30,"channel_code":"vl24h","url":"job_detail","page_name":"Trang chi tiết tin ","title":"Tuyển {TIEU_DE} tại {TEN_CONG_TY}","keywords":"tìm việc làm {TIEU_DE}, việc làm {TIEU_DE}, tuyển dụng {TIEU_DE}, viec lam {TIEU_DE_KHONG_DAU}","description":"{TEN_CONG_TY} tuyển dụng {TIEU_DE},  lương {MUC_LUONG}, phúc lợi tốt, làm việc tại {TINH_THANH}. Ứng tuyể