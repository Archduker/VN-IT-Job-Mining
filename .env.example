# ============================================================
# VN IT Job Mining — Biến Môi Trường (Environment Variables)
# Copy file này thành .env và điền các giá trị phù hợp
# ============================================================

# ============================================================
# CHẾ ĐỘ 1: Cloudflare R2 Cloud Lakehouse (Dùng chung cả Team)
# ============================================================
# Điền thông tin R2 của nhóm (hoặc chạy: python scripts/setup_cloud_storage.py):
S3_PROVIDER=cloudflare_r2
S3_ENDPOINT_URL=https://<your_account_id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=<your_r2_access_key_id>
AWS_SECRET_ACCESS_KEY=<your_r2_secret_access_key>
S3_BUCKET_NAME=vn-it-jobs
AWS_REGION=auto

# ============================================================
# CHẾ ĐỘ 2: MinIO Local (Chạy offline cục bộ trên máy cá nhân)
# ============================================================
# Bỏ comment các dòng dưới nếu muốn chạy offline trên máy:
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# MINIO_BUCKET=vn-it-jobs
# MINIO_SECURE=false

# --- Airflow Configuration ---
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False

# --- Crawling Settings ---
CRAWL_RECHECK_DAYS=21
CRAWL_DELAY_MIN=3.0
CRAWL_DELAY_MAX=5.5

# --- Telegram Alerts (Tùy chọn) ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
