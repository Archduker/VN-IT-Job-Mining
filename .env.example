# ============================================================
# VN IT Job Mining — Biến Môi Trường (Environment Variables)
# Copy file này thành .env và điền các giá trị phù hợp
# ============================================================

# --- MinIO Object Storage (Data Lakehouse) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=vn-it-jobs
MINIO_SECURE=false

# --- Airflow Configuration ---
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False

# --- Crawling Settings ---
CRAWL_RECHECK_DAYS=21
CRAWL_DELAY_MIN=1.5
CRAWL_DELAY_MAX=3.5

# --- Telegram Alerts (Tùy chọn) ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
