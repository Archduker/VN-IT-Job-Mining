# ============================================================
# VN-IT-Job-Mining — Production Environment Configuration
# Copy this file to .env and configure your credentials.
# ============================================================

# ============================================================
# 1. Cloudflare R2 Cloud Lakehouse (Độc quyền duy nhất cho cả team)
# ============================================================
S3_PROVIDER=cloudflare_r2
S3_ENDPOINT_URL=https://<your_account_id>.r2.cloudflarestorage.com
S3_BUCKET_NAME=vn-it-jobs
AWS_REGION=auto
AWS_ACCESS_KEY_ID=<your_r2_access_key_id>
AWS_SECRET_ACCESS_KEY=<your_r2_secret_access_key>

# Cloudflare R2 specific aliases
R2_ACCOUNT_ID=<your_account_id>
R2_BUCKET_NAME=vn-it-jobs
R2_ACCESS_KEY_ID=<your_r2_access_key_id>
R2_SECRET_ACCESS_KEY=<your_r2_secret_access_key>
R2_ENDPOINT_URL=https://<your_account_id>.r2.cloudflarestorage.com

# ============================================================
# 2. PostgreSQL Database (Zero-SQLite Policy)
# ============================================================
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@localhost:5432/airflow

# ============================================================
# 3. Apache Airflow Orchestration & Remote Logging
# ============================================================
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__LOGGING__REMOTE_LOGGING=True
AIRFLOW__LOGGING__REMOTE_BASE_LOG_FOLDER=s3://vn-it-jobs/airflow/logs
AIRFLOW__LOGGING__REMOTE_LOG_CONN_ID=r2_s3_conn

# ============================================================
# 4. Crawling & Policy Settings
# ============================================================
CRAWL_RECHECK_DAYS=21
CRAWL_DELAY_MIN=3.0
CRAWL_DELAY_MAX=5.5
