# ============================================================
# VN-IT-Job-Mining — Local MinIO defaults (recommended for development)
# Copy this file to .env. Never commit a real .env or cloud credentials.
# ============================================================
S3_PROVIDER=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE=http://localhost:9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=vn-it-jobs
MINIO_SECURE=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_WAIT_SECONDS=120

# The crawler's S3-compatible client also reads these standard variables.
# They must match the local MinIO credentials above for local development.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=vn-it-jobs

# ============================================================
# Optional: shared Cloudflare R2 lakehouse. Use R2 only after the team
# explicitly chooses it and sets real credentials in .env. Do not leave
# angle-bracket placeholders uncommented: they override local MinIO settings.
# ============================================================
# S3_PROVIDER=cloudflare_r2
# S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
# AWS_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
# AWS_REGION=auto
# S3_BUCKET_NAME=vn-it-jobs

# Existing project settings (kept for compatibility)
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False

# Crawling settings
CRAWL_RECHECK_DAYS=21
CRAWL_DELAY_MIN=1.5
CRAWL_DELAY_MAX=3.5

# Optional Telegram alerts: replace placeholders only in local .env
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
