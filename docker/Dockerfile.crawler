# ==============================================================================
# VN-IT-Job-Mining — Production Crawler Runner for VPS
# Super-lightweight, stateless runner designed for Cron / Systemd automation
# ==============================================================================

FROM python:3.12-slim

# Thiết lập biến môi trường tối ưu cho Python và Chrome/Chromium
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Ho_Chi_Minh \
    CHROME_BIN=/usr/bin/chromium \
    CHROME_PATH=/usr/bin/chromium

WORKDIR /app

# Cài đặt các gói hệ thống tối thiểu cần thiết cho Chromium và kết nối mạng
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    ca-certificates \
    tzdata \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Cài đặt các thư viện Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Sao chép mã nguồn crawler và scripts điều phối
COPY collection/ /app/collection/
COPY scripts/ /app/scripts/
COPY run.py /app/run.py

# Tạo thư mục dữ liệu cục bộ
RUN mkdir -p /app/data

# Khởi chạy runner
ENTRYPOINT ["python", "run.py"]
CMD ["--help"]
